with "config/ms_rest_config.gpr";
project Ms_Rest is

   for Source_Dirs use ("src/**", "config/", "tests/**");
   for Object_Dir use "obj/" & Ms_Rest_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ms_rest.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ms_Rest_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ms_Rest;
