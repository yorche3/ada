with "config/ms_soap_config.gpr";

project Test is

   for Languages use ("Ada");
   --  Alire establece GPR_PROJECT_PATH automáticamente
   for Source_Dirs use (
      "src/**",
      "config/",
      "tests/**"
   );
   
   package Builder is
      for Switches ("Ada") use ("-s");  --  Recompile if source changes
   end Builder;
   for Object_Dir use "obj/tests";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("run_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ms_Soap_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Test;
